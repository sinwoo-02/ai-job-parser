{
  "info": {
    "_postman_id": "fd7b4e56-8d4f-4c89-91f3-eb27725cbdb1",
    "name": "테스트 09(일반 사용자 ID 2 삭제 시도)",
    "description": "E2E 테스트: 일반 사용자의 채용 공고 삭제 시도(권한 제한) 시나리오",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 로그인 (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "일반 사용자 로그인 요청입니다."
      },
      "response": []
    },
    {
      "name": "2. 채용 공고 삭제 시도 (Delete Attempt - Forbidden)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    // 삭제는 관리자 권한이 필요하므로 일반 사용자는 403 응답을 받아야 합니다.",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/jobs/2",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "jobs",
            "2"
          ]
        },
        "description": "일반 사용자가 권한이 없는 공고 삭제를 시도합니다. (실패하는 것이 정상입니다)"
      },
      "response": []
    },
    {
      "name": "3. 로그아웃 (Logout)",
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/logout",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "logout"
          ]
        },
        "description": "현재 세션을 무효화하고 로그아웃합니다."
      },
      "response": []
    }
  ]
}
