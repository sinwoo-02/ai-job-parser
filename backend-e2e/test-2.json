{
  "info": {
    "_postman_id": "aea1c8d3-6b4f-4a75-87e8-22cb6d528b3d",
    "name": "테스트 02(일반 사용자 pdf 업로드)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 로그인 (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. PDF 업로드 (test.pdf)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              " pm.test(\"Status code is 403 Forbidden\", function () {\r",
              "         // 일반 사용자는 관리자 전용 기능인 PDF 업로드에 접근할 수 없으므로 403 응답이 정상입니다.\r",
              "         pm.response.to.have.status(403);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "description": "PDF 파일 업로드 (test.pdf)",
              "type": "file",
              "src": "test.pdf"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/sources/pdf",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "sources",
            "pdf"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. 로그아웃 (Logout)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/logout",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "logout"
          ]
        }
      },
      "response": []
    }
  ]
}
