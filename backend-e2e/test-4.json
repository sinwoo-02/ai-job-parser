{
  "info": {
    "_postman_id": "7bcefbb5-eeb4-4f2e-8628-afa3e7da66ed",
    "name": "테스트 04(일반 사용자 채용 공고 조회, PENDING 상태)",
    "description": "E2E 테스트: 일반 사용자 로그인, 전체 조회 및 로그아웃 시나리오",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 로그인 (Login)",
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "일반 사용자 로그인 요청입니다."
      },
      "response": []
    },
    {
      "name": "2. 채용 공고 수정 시도 (Update Attempt - Forbidden)",
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    // 일반 사용자는 관리자 권한이 필요한 수정을 할 수 없으므로 403 응답이 정상입니다.",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/jobs/2",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "jobs",
            "2"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        },
        "description": "일반 사용자가 권한이 없는 공고 수정을 시도합니다. (실패하는 것이 정상입니다)"
      },
      "response": []
    },
    {
      "name": "3. 취업 정보 전체 조회 (List Job Postings)",
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response status is SUCCESS\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"success\");",
              "});",
              "// 현재 관리자가 취업 정보 상태를 변경(승인)하지 않았기 때문에 아무 정보가 넘어오지 않는 것이 정상입니다.",
              "pm.test(\"Check if content is empty (Normal without admin approval)\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.content).to.be.an('array');",
              "    pm.expect(jsonData.data.content.length).to.eql(0, \"데이터가 비어있어야 하지만 정보가 조회되었습니다.\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/jobs",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "jobs"
          ]
        },
        "description": "승인된 채용 공고 목록을 조회합니다. 이 단계에서는 앞선 수정 시도가 실패했으므로 목록 상태에 영향이 없어야 합니다."
      },
      "response": []
    },
    {
      "name": "4. 로그아웃 (Logout)",
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/logout",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "logout"
          ]
        },
        "description": "현재 세션을 무효화하고 로그아웃합니다."
      },
      "response": []
    }
  ]
}
