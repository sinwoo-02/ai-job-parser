    "name": "테스트 06(일반 사용자 전체 공고 조회)",
    "description": "E2E 테스트: 일반 사용자 로그인, 전체 조회(ID 2번 검증) 및 로그아웃 시나리오",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 로그인 (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "일반 사용자 로그인 요청입니다."
      },
      "response": []
    },
    {
      "name": "2. 전체 채용 공고 조회 (List Job Postings)",
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Job ID 2 should be present in the list\", function () {",
              "    var jsonData = pm.response.json();",
              "    var jobs = jsonData.data.content;",
              "    var job2 = jobs.find(job => job.id === 2);",
              "    ",
              "    pm.expect(job2).to.not.be.undefined;",
              "    pm.expect(job2.status).to.eql(\"APPROVED\");",
              "});"
            ]
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/jobs",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "jobs"
          ]
        },
        "description": "전체 승인된 공고를 조회하고 ID 2번이 포함되어 있는지 확인합니다."
      },
      "response": []
    },
    {
      "name": "3. 로그아웃 (Logout)",
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "POST",
