    {
      "name": "2. 삭제된 공고 조회 시도 (Get Deleted Job ID 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Should return error or not found\", function () {",
              "    // 삭제된 데이터이므로 404 상태코드이거나, 성공 응답이더라도 데이터가 null인 것이 정상입니다.",
              "    var statusCode = pm.response.code;",
              "    if (statusCode === 404) {",
              "        pm.expect(statusCode).to.equal(404);",
              "    } else if (statusCode === 200) {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData.data).to.be.null;",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/jobs/2",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "jobs",
            "2"
          ]
        },
        "description": "삭제된 ID 2번 공고의 상세 정보를 조회합니다. 데이터가 없는 것이 정상입니다."
      },
      "response": []
    },
    {
      "name": "3. 로그아웃 (Logout)",
