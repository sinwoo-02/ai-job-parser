{
  "info": {
    "_postman_id": "49720578-7169-4177-9d37-80226520d555",
    "name": "테스트 03(관리자 로그인 및 pdf 업로드)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 관리자 로그인 (Admin Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. PDF 업로드 (test.pdf)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "         pm.response.to.have.status(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "description": "PDF 파일 업로드 (test.pdf)",
              "type": "file",
              "key": "file",
              "src": "test.pdf"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/sources/pdf",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "sources",
            "pdf"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. 채용 공고 전체 조회 (List Job Postings)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Total number of job postings is 11\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.totalElements).to.eql(11);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/jobs?page=0&size=20",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "jobs"
          ],
          "query": [
            {
              "key": "page",
              "value": "0",
              "description": "페이지 번호 (0부터 시작)"
            },
            {
              "key": "size",
              "value": "20",
              "description": "페이지당 데이터 수"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. 잘못된 형식 PDF 업로드하기",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () { pm.response.to.have.status(400); }); "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "type": "file",
              "description": "PDF 형식이 아닌 파일 업로드 테스트",
              "key": "file",
              "src": "test.txt"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/sources/pdf",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "sources",
            "pdf"
          ]
        }
      },
      "response": []
    },
    {
